# Receipt Automation System - Environment Variables Example
# Copy this file to .env and fill in your actual values

# ===== REQUIRED SETTINGS =====

# PDF Source Application Credentials (Required for PDF downloading)
PDF_SOURCE_USERNAME=your_username
PDF_SOURCE_PASSWORD=your_password

# Email Configuration (Required for sending emails)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
SENDER_EMAIL=your_email@example.com
INTERNAL_EMAIL=notifications@example.com

# Flask Secret Key (Required for session security)
# Generate a secure random key, e.g., using: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=generate_a_secure_random_key

# ===== OPTIONAL SETTINGS =====

# OpenAI API Key (Optional, for AI features)
OPENAI_API_KEY=your_openai_api_key

# Microsoft Graph API Configuration (Optional, for email integration)
MS_TENANT_ID=your_tenant_id_here
MS_CLIENT_ID=your_client_id_here
MS_CLIENT_SECRET=your_client_secret_here

# Directory Configuration (Optional, defaults will be used if not specified)
DOWNLOAD_DIR=downloads
PROCESSED_DIR=processed

# Database Configuration (Optional, default is sqlite:///invoice_emails.db)
DATABASE_URL=sqlite:///invoice_emails.db

# Application Settings (Optional)
DEBUG=False
ENABLE_LOGGING=True
LOG_LEVEL=INFO

# PDF Source Application Configuration
PDF_APP_URL=https://your-pdf-app-url.com
PDF_APP_USERNAME=your_username
# PDF_APP_PASSWORD=your_password

# Parasut Configuration
PARASUT_URL=https://parasut.com
PARASUT_USERNAME=your_parasut_username
PARASUT_PASSWORD=your_parasut_password

# PDF Processing Configuration
DOWNLOAD_DIR=downloads
PROCESSED_DIR=processed

# Logging Configuration
LOG_FILE=automation_log.txt

# API Keys
# SECURITY NOTE: Store API keys in a secure vault in production
DEEPSEEK_API_KEY=your_api_key_here

# Internal Department Configuration
INTERNAL_DEPT_EMAIL=internal_dept@yourcompany.com 